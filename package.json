{
  "name": "local-delivery-platform",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "expo start",
    "server": "node server/index.js",
    "db:migrate": "node server/migrate.js",
    "db:migrate:all": "node server/migrate.js && node server/migrate_customer.js && node server/migrate_marketing.js && node server/migrate_financials.js && node server/migrate_catalog.js && node server/migrate_media.js && node server/migrate_operations.js && node server/migrate_membership_v2.js && node server/migrate_operations_v3.js && node server/migrate_delivery_proof.js && node server/migrate_refunds.js && node server/migrate_payment_adjustments.js && node server/migrate_dispatch_flow.js && node server/migrate_order_item_adjustments.js && node server/migrate_account_settings.js && node server/migrate_ratings.js && node server/migrate_super_admin.js",
    "db:seed": "node server/seed.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/unit",
    "test:e2e": "node --test tests/e2e",
    "db:migrate:delivery": "node server/migrate_delivery.js",
    "db:migrate:marketing": "node server/migrate_marketing.js",
    "db:migrate:customer": "node server/migrate_customer.js",
    "db:migrate:financials": "node server/migrate_financials.js",
    "db:migrate:catalog": "node server/migrate_catalog.js",
    "db:migrate:media": "node server/migrate_media.js",
    "db:migrate:operations": "node server/migrate_operations.js",
    "db:migrate:membership-v2": "node server/migrate_membership_v2.js",
    "db:migrate:delivery-proof": "node server/migrate_delivery_proof.js",
    "db:migrate:refunds": "node server/migrate_refunds.js",
    "db:migrate:payment-adjustments": "node server/migrate_payment_adjustments.js",
    "db:migrate:dispatch": "node server/migrate_dispatch_flow.js",
    "db:migrate:item-adjustments": "node server/migrate_order_item_adjustments.js",
    "db:migrate:ratings": "node server/migrate_ratings.js",
    "db:migrate:super-admin": "node server/migrate_super_admin.js",
    "audit:workflow": "npm run test && npm run lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.17",
    "expo-constants": "~57.0.16",
    "expo-location": "~57.0.15",
    "expo-image-picker": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-task-manager": "~57.0.14",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-maps": "1.27.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "express": "5.1.0",
    "pg": "^8.16.3",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "helmet": "^8.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^8.2.1",
    "@sentry/node": "^10.19.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3",
    "prettier": "^3.6.2",
    "eslint": "^9.35.0",
    "@eslint/js": "^9.35.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0"
  }
}
